TRANSCRIBER_FACTORY=app.transcription.model_registry:create_transcriber
TRANSCRIPTION_LANGUAGE=zh
TRANSCRIPTION_MODEL_CONFIG_PATH=backend/data/asr_model.json

# 默认对象存储是 MinIO/S3 兼容服务。自定义服务可将 STORAGE_FACTORY 指向
# package.module:create_store；该工厂接收 ScannerSettings，需实现
# backend/app/storage/contract.py 的 RecordingStore 方法。
STORAGE_FACTORY=app.storage.minio_store:create_store
STORAGE_BUCKET=recordingbean
STORAGE_RECORDINGS_PREFIX=recordings/
STORAGE_NOTES_PREFIX=notes/

ASR_BASE_URL=http://192.168.0.33:7860
ASR_HEALTH_PATH=/health
ASR_TRANSCRIBE_PATH=/transcribe
ASR_TIMEOUT_SECONDS=600
ASR_HEALTH_TIMEOUT_SECONDS=2.5
ASR_HEALTH_CACHE_SECONDS=10
ASR_CHUNK_WORKERS=2

# 局域网阿里 Qwen3-ASR-1.7B 服务。不使用云端 API Key。
QWEN_ASR_BASE_URL=http://192.168.0.22:18005
QWEN_ASR_HEALTH_PATH=/health
QWEN_ASR_TRANSCRIBE_PATH=/transcribe
QWEN_ASR_TIMEOUT_SECONDS=600
QWEN_ASR_CHUNK_SECONDS=15
QWEN_ASR_CHUNK_RETRIES=3
QWEN_ASR_CHUNK_WORKERS=2

# 可选的第三方 ASR。启用后手机“转写服务”列表会显示“自定义 HTTP ASR”；
# 如需调用供应商 SDK 或异步任务 API，可将 CUSTOM_ASR_FACTORY 替换为自己的工厂。
CUSTOM_ASR_ENABLED=0
CUSTOM_ASR_NAME=自定义 HTTP ASR
CUSTOM_ASR_DESCRIPTION=用户配置的 multipart HTTP 转写服务
CUSTOM_ASR_FACTORY=app.transcription.custom_http_adapter:create_transcriber
CUSTOM_ASR_BASE_URL=
CUSTOM_ASR_HEALTH_PATH=/health
CUSTOM_ASR_TRANSCRIBE_PATH=/transcribe
CUSTOM_ASR_TIMEOUT_SECONDS=600
CUSTOM_ASR_FILE_FIELD=file
CUSTOM_ASR_LANGUAGE_FIELD=language
CUSTOM_ASR_PROMPT_FIELD=prompt
CUSTOM_ASR_RESPONSE_TEXT_PATH=text
CUSTOM_ASR_RESPONSE_LANGUAGE_PATH=language
CUSTOM_ASR_RESPONSE_MODEL_PATH=model
CUSTOM_ASR_RESPONSE_SEGMENTS_PATH=segments
CUSTOM_ASR_API_KEY=
CUSTOM_ASR_API_KEY_HEADER=Authorization
CUSTOM_ASR_API_KEY_PREFIX="Bearer "
CUSTOM_ASR_HEADERS_JSON=

# 工作内容筛选使用独立的 OpenAI 兼容文本模型。未配置时扫描器不会把未筛选全文上传到笔记。
WORK_FILTER_BASE_URL=http://192.168.0.184:11235
WORK_FILTER_CHAT_PATH=/v1/chat/completions
WORK_FILTER_MODEL=DeepSeek-V4-Flash-0731-MLX-Serve-mixed-2-3-8bit
WORK_FILTER_API_KEY=
WORK_FILTER_TIMEOUT_SECONDS=180
WORK_FILTER_MAX_TOKENS=4096
WORK_FILTER_WORKERS=1
WORK_FILTER_RETRIES=3

SCAN_INTERVAL_SECONDS=15
TRANSCRIPTION_MAX_ATTEMPTS=3
TRANSCRIPTION_RETRY_DELAY_SECONDS=60
TRANSCRIPTION_DB_PATH=backend/data/transcriptions.db

OBSIDIAN_VAULT_PATH=/Users/你的用户名/Documents/Obsidian Vault
OBSIDIAN_NOTES_FOLDER=AI录音豆

MINIO_ENDPOINT=http://192.168.0.111:30900
MINIO_ACCESS_KEY=请填写
MINIO_SECRET_KEY=请填写
MINIO_BUCKET=recordingbean
MINIO_RECORDINGS_PREFIX=recordings/
MINIO_NOTES_PREFIX=notes/
